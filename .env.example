# Local development settings. Copy to .env and supply credentials for a dedicated database.
DB_URL=jdbc:mysql://localhost:3306/hrgenius?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hrgenius
DB_PASSWORD=
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Required: set unique random secret material of at least 32 bytes before starting the backend.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_LOCK_MINUTES=15
AUTH_COOKIE_SECURE=false
# Optional one-time bootstrap. Keep unset except during initial local setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=HR
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
# Optional outbound email. Configure SMTP_HOST/PORT/USERNAME/PASSWORD and enable only after credentials are set.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ATTENDANCE_TIME_ZONE=Asia/Kolkata
